# Copy to .env for local Docker use. Never commit .env or production credentials.

# Local/demo signing secret only. Generate a unique value for any shared deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CODNA_AUTH_SECRET=replace-with-a-unique-random-secret
CODNA_COOKIE_SECURE=false
# Hosted dashboard/API on separate domains (such as Render onrender.com): set to none.
# Keep lax for same-site/local development. SameSite=None requires Secure=true.
CODNA_COOKIE_SAMESITE=lax
CODNA_FRONTEND_URL=http://localhost:5173/dashboard/
CODNA_DATA_DIR=/codna-data

# Default local database is SQLite in the persistent Docker volume.
# For the optional Compose PostgreSQL profile, set the URL below and configure
# POSTGRES_PASSWORD. Inside Compose, use hostname `postgres`, not localhost.
# CODNA_DATABASE_URL=postgresql+psycopg://codna:replace-this-password@postgres:5432/codna
POSTGRES_DB=codna
POSTGRES_USER=codna
POSTGRES_PASSWORD=replace-this-local-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Optional GitHub OAuth credentials, if configured in auth.py:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:8001/auth/github/callback

# For an HTTPS deployment, use the public dashboard origin/path and set
# CODNA_COOKIE_SECURE=true. Configure OAuth callback URLs to your public API.
